DB_ADDR="localhost:1090"
DB_HOST="localhost"
DB_PORT="1090"
DB_NAME="journey"
DB_USERNAME="your_db_username"
DB_PASSWORD="your_db_password"
DB_URL="jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}"
REDIS_HOST="localhost"
REDIS_PORT="6379"
AGENT_SERVICE_URL="http://localhost:8800"
AGENT_BASE_URL="http://localhost:8800"
ASSET_STORAGE_HOST_DIR=""
# Signs the access JWTs. At least 32 bytes; generate one with: openssl rand -base64 48
# agent-services must use the exact same value. Left empty, a random one is used per start (everyone is
# signed out on restart and agent-services cannot verify tokens), so only leave it empty for quick local tests.
JWT_SECRET=""
# "true" when the app is served over HTTPS (anything but localhost), so the refresh cookie is HTTPS-only.
AUTH_COOKIE_SECURE="false"
# SMTP server for password reset emails. Leave MAIL_HOST unset to use the Mailpit test server from
# docker-compose (read the emails at http://localhost:8025). For real email, set your provider's server
# (usually port 587) plus MAIL_USERNAME/MAIL_PASSWORD, MAIL_SMTP_AUTH="true" and MAIL_STARTTLS="true".
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_SMTP_AUTH="true"
MAIL_STARTTLS="true"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM="Journey <no-reply@example.com>"
# Where the frontend is served; links in emails point here.
APP_BASE_URL="http://localhost:5173"
# Port for the Mailpit web page (default 8025).
# MAILPIT_UI_PORT="8025"
