{
	servers {
		# Requests arrive from cloudflared (a private Docker address); take the visitor's real IP from the
		# header Cloudflare adds. The API uses it for its per-IP rate limits.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip
	}
}

:80 {
	handle /api/* {
		reverse_proxy api-layer:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		reverse_proxy frontend:80
	}
}
