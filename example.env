# Settings for the root docker-compose.yml (the whole app). Copy to .env and fill in.
# Each folder's own example.env is only for running that part on its own.
# Inside Docker, services reach each other by service name: db, redis, api-layer, journey-agents, frontend, caddy.

# ---------------------------------------------------------------------------------------------------------
# Domain and Cloudflare Tunnel
# ---------------------------------------------------------------------------------------------------------
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install token. In the tunnel's Public Hostname,
# set your domain (e.g. journey.example.com) to the service http://caddy:80.
TUNNEL_TOKEN=
# Host port for Caddy, to reach the site without the tunnel (e.g. http://<server-ip>:8000 on the LAN).
CADDY_PORT=8000
# The site's public address (no trailing slash). Links in emails (password reset) point here.
APP_BASE_URL=https://journey.example.com
# true when served over HTTPS (Cloudflare always is): the sign-in cookie is then sent over HTTPS only.
AUTH_COOKIE_SECURE=true

# ---------------------------------------------------------------------------------------------------------
# Database (backend/)
# ---------------------------------------------------------------------------------------------------------
POSTGRES_DB=journey
POSTGRES_USER=journey
# Generate with: openssl rand -base64 32 | tr -d '/+='   (avoid / + = so it also works inside the URLs below)
POSTGRES_PASSWORD=
# Host port for Postgres (for running migrations with psql). Remove the port mapping if you never need it.
DB_PORT=5432

# ---------------------------------------------------------------------------------------------------------
# Journey API (journey-app/)
# ---------------------------------------------------------------------------------------------------------
# Same database, user and password as above; "db" is the Postgres service name.
DB_URL=jdbc:postgresql://db:5432/journey
DB_USERNAME=journey
DB_PASSWORD=
REDIS_PORT=6379
AGENT_SERVICE_URL=http://journey-agents:8800
# Signs sign-in tokens. At least 32 bytes; generate with: openssl rand -base64 48
# Shared with agent-services (it verifies the same tokens).
JWT_SECRET=
# Host folder for stored images (shared by the API and agent-services). Defaults to ./data/assets.
ASSET_STORAGE_HOST_DIR=
# Per-IP request limits. Leave on in production.
RATE_LIMIT_ENABLED=true

# Email (password reset) through Resend SMTP. In Resend: add and verify your domain (it gives DNS records to
# add in Cloudflare DNS), then create an API key with sending access. The username is literally "resend".
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=resend
# Your Resend API key (re_...).
MAIL_PASSWORD=
# Must be an address on the domain verified in Resend.
MAIL_FROM=Journey <no-reply@journey.example.com>

# ---------------------------------------------------------------------------------------------------------
# Agent services (agent-services/, optional: rules importing and AI tools)
# ---------------------------------------------------------------------------------------------------------
OPENAI_API_KEY=
# Same database as above: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=postgresql://journey:<password>@db:5432/journey
AGENT_PORT=8800
# Empty picks a worker count from the CPUs.
MAX_WORKERS=

# ---------------------------------------------------------------------------------------------------------
# Frontend (frontend/journey-frontend/)
# ---------------------------------------------------------------------------------------------------------
# Host port for the frontend container on its own (Caddy reaches it inside Docker either way).
FRONTEND_PORT=3000
# Memory (MB) for the frontend build; lower it on a small machine, raise it if the build runs out.
FRONTEND_BUILD_MEMORY_MB=1024
# Where the app sends API calls; keep /api/v1 when it is served through Caddy. Baked in at build time.
VITE_API_BASE_URL=/api/v1
